{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeoffice.local/schemas/project-blueprint.schema.json",
  "title": "VibeOffice Project Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectName",
    "oneLineDefinition",
    "projectType",
    "targetUsers",
    "coreProblem",
    "successMoment",
    "scope",
    "constraints",
    "technicalDirection",
    "risks",
    "openQuestions"
  ],
  "properties": {
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "oneLineDefinition": {
      "type": "string",
      "minLength": 10
    },
    "projectType": {
      "type": "string",
      "enum": [
        "landing_demo",
        "crud_web",
        "dashboard",
        "ai_demo",
        "portfolio",
        "existing_project",
        "other"
      ]
    },
    "targetUsers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coreProblem": {
      "type": "string",
      "minLength": 10
    },
    "successMoment": {
      "type": "string",
      "minLength": 10
    },
    "valueProposition": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "must",
        "should",
        "later",
        "out"
      ],
      "properties": {
        "must": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "should": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "later": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillLevel"
      ],
      "properties": {
        "teamSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 20
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "skillLevel": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate"
          ]
        },
        "requiredStack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgetNote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "technicalDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prototypeStrategy",
        "auth",
        "dataPersistence",
        "aiIntegration"
      ],
      "properties": {
        "prototypeStrategy": {
          "type": "string"
        },
        "frontend": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "type": "string",
          "enum": [
            "none",
            "mock",
            "required",
            "later",
            "unknown"
          ]
        },
        "dataPersistence": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "database",
            "later",
            "unknown"
          ]
        },
        "aiIntegration": {
          "type": "string",
          "enum": [
            "none",
            "mock",
            "external_api",
            "local_model",
            "later",
            "unknown"
          ]
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "mitigation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "userValue",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "userValue": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
    "filename": "FINAL.md",
    "required_sections": ["Purpose", "Audience", "Decision or requested action", "Body", "Evidence", "Owner and next step"],
    "rules": ["Use requested format", "Use DOCX render QA when DOCX is requested", "Use explicit headings and document metadata"]
  },
